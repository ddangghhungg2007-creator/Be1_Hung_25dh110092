@model List<Be1_Hung_25dh110092.Models.CartItem>

@{
    ViewBag.Title = "Giỏ hàng";

    decimal total = 0;

    if (Model != null)
    {
        total = Model.Sum(x => x.TotalPrice);
    }
}

<style>
    .cart-title {
        background: #e8f5e9;
        padding: 15px;
        border-left: 5px solid #2e7d32;
        margin-bottom: 25px;
    }

    .cart-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
    }

        .cart-table th {
            background: #2e7d32;
            color: white;
            padding: 12px;
            text-align: center;
        }

        .cart-table td {
            border: 1px solid #ddd;
            padding: 12px;
            vertical-align: middle;
            text-align: center;
        }

    .cart-image {
        width: 80px;
        height: 100px;
        object-fit: contain;
    }

    .cart-total {
        background: #f5f5f5;
        border: 1px solid #ddd;
        padding: 20px;
        margin-top: 20px;
        text-align: right;
    }

    .total-price {
        color: #d32f2f;
        font-size: 24px;
        font-weight: bold;
    }

    .cart-actions {
        margin-top: 20px;
    }
</style>

<div class="cart-title">
    <h2>GIỎ HÀNG CỦA BẠN</h2>
    <p>Kiểm tra sản phẩm trước khi tiếp tục mua hàng.</p>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        Giỏ hàng của bạn đang trống.
    </div>

    @Html.ActionLink(
        "Tiếp tục mua hàng",
        "Index",
        "Home",
        null,
        new { @class = "btn btn-success" }
    )
}
else
{
    <div style="overflow-x: auto;">
        <table class="cart-table">
            <thead>
                <tr>
                    <th>Hình ảnh</th>
                    <th>Sản phẩm</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th>Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="@item.Image"
                                 alt="@item.ProductName"
                                 style="width: 100px; height: 100px; object-fit: contain;" />
                        </td>

                        <td>
                            @item.Product.ProductName
                        </td>

                        <td>
                            @item.Product.ProductPrice.ToString("N0") đ
                        </td>

                        <td>
                            @using (Html.BeginForm(
                                "UpdateQuantity",
                                "Cart",
                                FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()

                                @Html.Hidden(
                                    "id",
                                    item.Product.ProductID
                                )

                                <input type="number"
                                       name="quantity"
                                       value="@item.Quantity"
                                       min="1"
                                       class="form-control"
                                       style="width: 80px; display: inline-block;" />

                                <button type="submit"
                                        class="btn btn-primary btn-sm">
                                    Cập nhật
                                </button>
                            }
                        </td>

                        <td style="color: red; font-weight: bold;">
                            @item.TotalPrice.ToString("N0") đ
                        </td>

                        <td>
                            @using (Html.BeginForm(
                                "RemoveFromCart",
                                "Cart",
                                FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()

                                @Html.Hidden(
                                    "id",
                                    item.Product.ProductID
                                )

                                <button type="submit"
                                        class="btn btn-danger btn-sm"
                                        onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">
                                    Xóa
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="cart-total">
        <h4>Tổng tiền:</h4>

        <p class="total-price">
            @total.ToString("N0") đ
        </p>

        <div class="cart-actions">
            @using (Html.BeginForm(
                "ClearCart",
                "Cart",
                FormMethod.Post,
                new { style = "display:inline-block; margin-right:10px;" }))
            {
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-danger"
                        onclick="return confirm('Bạn có chắc muốn xóa toàn bộ giỏ hàng?');">
                    Xóa giỏ hàng
                </button>
            }

            @Html.ActionLink(
                "Tiếp tục mua hàng",
                "Index",
                "Home",
                null,
                new { @class = "btn btn-default" }
            )

            @Html.ActionLink(
                "Tiến hành thanh toán",
                "Checkout",
                "Order",
                null,
                new { @class = "btn btn-success" }
)
        </div>
    </div>
}