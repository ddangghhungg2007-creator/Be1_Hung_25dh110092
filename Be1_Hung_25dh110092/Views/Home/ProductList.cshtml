@model IEnumerable<Be1_Hung_25dh110092.Models.Product>

@{
    ViewBag.Title = "Danh sách sản phẩm";
}

<style>
    .list-title {
        background: #e8f5e9;
        padding: 15px;
        border-left: 5px solid #2e7d32;
        margin-bottom: 20px;
    }

    .list-products {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
    }

    .item-product {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 15px;
        text-align: center;
    }

        .item-product img {
            width: 100%;
            height: 180px;
            object-fit: contain;
        }

    .item-price {
        color: red;
        font-weight: bold;
        font-size: 17px;
    }

    @@media (max-width: 768px) {
        .list-products {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>

<div class="list-title">
    <h2>@ViewBag.CategoryName</h2>
</div>

@using (Html.BeginForm("ProductList", "Home", FormMethod.Get))
{
    <div class="form-group">
        @Html.TextBox(
            "searchTerm",
            ViewBag.SearchTerm as string,
            new
            {
                @class = "form-control",
                placeholder = "Tìm kiếm sản phẩm..."
            })

        <button type="submit" class="btn btn-success"
                style="margin-top: 10px;">
            Tìm kiếm
        </button>
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="list-products">
        @foreach (var product in Model)
        {
            <div class="item-product">
                <a href="@Url.Action(
                    "ProductDetail",
                    "Home",
                    new { id = product.ProductID })">

                    <img src="@Url.Content(/* "~/Content/Images/" +*/ product.ProductImage)"
                         alt="@product.ProductName" />
                </a>

                <h4>@product.ProductName</h4>

                <p class="item-price">
                    @product.ProductPrice.ToString("N0") đ
                </p>

                @Html.ActionLink(
                    "Xem chi tiết",
                    "ProductDetail",
                    "Home",
                    new { id = product.ProductID },
                    new { @class = "btn btn-primary" }
                )
            </div>
        }
    </div>
}
else
{
    <p>Không có sản phẩm phù hợp.</p>
}

<div style="margin-top: 20px;">
    @Html.ActionLink(
        "Quay lại trang chủ",
        "Index",
        "Home",
        null,
        new { @class = "btn btn-default" }
    )
</div>