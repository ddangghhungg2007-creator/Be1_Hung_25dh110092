@model Be1_Hung_25dh110092.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .order-title {
        background-color: #E8F5E9;
        color: #2E7D32;
        padding: 15px;
        border-left: 5px solid #4CAF50;
    }

    .detail-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }

        .detail-table th {
            background-color: #4CAF50;
            color: white;
            padding: 12px;
        }

        .detail-table td {
            padding: 10px;
            border: 1px solid #ddd;
        }
</style>

<h2 class="order-title">CHI TIẾT ĐƠN HÀNG</h2>

<div>
    <dl class="dl-horizontal">

        <dt>Mã đơn hàng</dt>
        <dd>@Model.OrderID</dd>

        <dt>Khách hàng</dt>
        <dd>
            @(Model.Customer != null ? Model.Customer.CustomerName : "")
        </dd>

        <dt>Ngày đặt</dt>
        <dd>@Model.OrderDate.ToString("dd/MM/yyyy")</dd>

        <dt>Tổng tiền</dt>
        <dd>@Model.TotalAmount.ToString("N0") đ</dd>

        <dt>Thanh toán</dt>
        <dd>@Model.PaymentStatus</dd>

        <dt>Địa chỉ giao hàng</dt>
        <dd>@Model.AddressDelivery</dd>

    </dl>
</div>

<hr />

<h3>Danh sách sản phẩm trong đơn hàng</h3>

<table class="detail-table">
    <thead>
        <tr>
            <th>Mã sản phẩm</th>
            <th>Tên sản phẩm</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Thành tiền</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.OrderDetails)
        {
            <tr>
                <td>@item.ProductID</td>

                <td>
                    @(item.Product != null ? item.Product.ProductName : "Không có sản phẩm")
                </td>

                <td>@item.Quantity</td>

                <td>@item.UnitPrice.ToString("N0") đ</td>

                <td>@((item.Quantity * item.UnitPrice).ToString("N0")) đ</td>
            </tr>
        }
    </tbody>
</table>

<br />

<p>
    @Html.ActionLink("Chỉnh sửa", "Edit",
        new { id = Model.OrderID },
        new { @class = "btn btn-warning" })

    @Html.ActionLink("Quay lại", "Index",
        null,
        new { @class = "btn btn-default" })
</p>