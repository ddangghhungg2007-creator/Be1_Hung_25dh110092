@model IEnumerable<Be1_Hung_25dh110092.Models.Order>

@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .order-title {
        background-color: #E8F5E9;
        color: #2E7D32;
        padding: 15px;
        border-left: 5px solid #4CAF50;
        margin-bottom: 20px;
        font-weight: bold;
    }

    .order-table {
        width: 100%;
        border-collapse: collapse;
    }

        .order-table th {
            background-color: #4CAF50;
            color: white;
            padding: 12px;
            text-align: center;
        }

        .order-table td {
            padding: 10px;
            border: 1px solid #ddd;
            text-align: center;
        }

        .order-table tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        .order-table tr:hover {
            background-color: #E8F5E9;
        }
</style>

<h2 class="order-title">QUẢN LÝ ĐƠN HÀNG</h2>

<div style="margin-bottom:20px;">
    @using (Html.BeginForm("Index", "Orders", FormMethod.Get))
    {
        @Html.TextBox("tuKhoa", ViewBag.TuKhoa as string,
            new { @class = "form-control", placeholder = "Tìm khách hàng, trạng thái, địa chỉ..." })

        <button type="submit" class="btn btn-primary">
            Tìm kiếm
        </button>

        @Html.ActionLink("Làm mới", "Index", null,
            new { @class = "btn btn-default" })
    }
</div>

<p>
    @Html.ActionLink("Thêm đơn hàng", "Create", null,
        new { @class = "btn btn-success" })
</p>

<div style="overflow-x:auto;">
    <table class="order-table">
        <thead>
            <tr>
                <th>Mã đơn hàng</th>
                <th>Khách hàng</th>
                <th>Ngày đặt</th>
                <th>Tổng tiền</th>
                <th>Trạng thái</th>
                <th>Địa chỉ giao hàng</th>
                <th>Số sản phẩm</th>
                <th>Thao tác</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.OrderID</td>

                    <td>
                        @(item.Customer != null ? item.Customer.CustomerName : "")
                    </td>

                    <td>
                        @item.OrderDate.ToString("dd/MM/yyyy")
                    </td>

                    <td>
                        @item.TotalAmount.ToString("N0") đ
                    </td>

                    <td>@item.PaymentStatus</td>

                    <td>@item.AddressDelivery</td>

                    <td>@item.OrderDetails.Count</td>

                    <td>
                        @Html.ActionLink("Sửa", "Edit",
                            new { id = item.OrderID },
                            new { @class = "btn btn-warning btn-sm" })

                        @Html.ActionLink("Chi tiết", "Details",
                            new { id = item.OrderID },
                            new { @class = "btn btn-info btn-sm" })

                        @Html.ActionLink("Xóa", "Delete",
                            new { id = item.OrderID },
                            new { @class = "btn btn-danger btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>