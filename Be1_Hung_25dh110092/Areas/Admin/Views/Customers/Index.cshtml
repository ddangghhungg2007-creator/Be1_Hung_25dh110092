@model IEnumerable<Be1_Hung_25dh110092.Models.Customer>

@{
    ViewBag.Title = "Quản lý khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .customer-title {
        background-color: #E8F5E9;
        color: #2E7D32;
        padding: 15px;
        border-left: 5px solid #4CAF50;
        margin-bottom: 20px;
        font-weight: bold;
    }

    .customer-table {
        width: 100%;
        border-collapse: collapse;
    }

        .customer-table th {
            background-color: #4CAF50;
            color: white;
            padding: 12px;
            text-align: center;
        }

        .customer-table td {
            padding: 10px;
            border: 1px solid #ddd;
            text-align: center;
        }

        .customer-table tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        .customer-table tr:hover {
            background-color: #E8F5E9;
        }

    .customer-search {
        margin-bottom: 20px;
    }

        .customer-search input {
            width: 300px;
            display: inline-block;
        }
</style>

<h2 class="customer-title">QUẢN LÝ KHÁCH HÀNG</h2>

<div class="customer-search">
    @using (Html.BeginForm("Index", "Customers", FormMethod.Get))
    {
        @Html.TextBox("tuKhoa", ViewBag.TuKhoa as string,
            new { @class = "form-control", placeholder = "Nhập tên, email hoặc số điện thoại..." })

        <button type="submit" class="btn btn-primary">
            Tìm kiếm
        </button>

        @Html.ActionLink("Làm mới", "Index", null,
            new { @class = "btn btn-default" })
    }
</div>

<p>
    @Html.ActionLink("Thêm khách hàng", "Create", null,
        new { @class = "btn btn-success" })
</p>

<div style="overflow-x:auto;">
    <table class="customer-table">
        <thead>
            <tr>
                <th>Mã KH</th>
                <th>Họ và tên</th>
                <th>Số điện thoại</th>
                <th>Email</th>
                <th>Địa chỉ</th>
                <th>Tài khoản</th>
                <th>Thao tác</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CustomerID</td>

                    <td>@item.CustomerName</td>

                    <td>@item.CustomerPhone</td>

                    <td>@item.CustomerEmail</td>

                    <td>@item.CustomerAddress</td>

                    <td>@item.Username</td>

                    @*<td>
                        @(item.User != null ? item.User.UserRole : "")
                    </td>*@

                    <td>
                        @Html.ActionLink("Sửa", "Edit",
                            new { id = item.CustomerID },
                            new { @class = "btn btn-warning btn-sm" })

                        @Html.ActionLink("Chi tiết", "Details",
                            new { id = item.CustomerID },
                            new { @class = "btn btn-info btn-sm" })

                        @Html.ActionLink("Xóa", "Delete",
                            new { id = item.CustomerID },
                            new { @class = "btn btn-danger btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>